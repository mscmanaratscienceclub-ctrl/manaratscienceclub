{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".email-preview",
    "paths": { "@/*": ["./src/*"] },
    "noEmit": false
  },
  "include": ["scripts/render-email-preview.ts", "src/lib/email/templates/*.ts", "src/lib/data/index.ts", "src/lib/admin/bulk-email.ts"]
}

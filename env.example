# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth
# WARNING: never ship the placeholder below. Generate a long random string
# (e.g. `openssl rand -base64 32`); with a weak/known secret session tokens
# can be forged.
BETTER_AUTH_SECRET="secret_key"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Resend Email
# The from domain must be verified in Resend (Domains → add DNS records).
# An unverified sender is refused with "domain is not verified".
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="Manarat Science Club <info@manaratscience.club>"

# Supabase (for file uploads)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR_KEY]
SUPABASE_SERVICE_ROLE_KEY=

# On Vercel, set NEXT_PUBLIC_BASE_URL to your production URL (e.g. https://manaratscience.club)
# and ensure DATABASE_URL, DIRECT_URL, BETTER_AUTH_SECRET and EMAIL_FROM are all
# set in Vercel env vars.
# It also drives metadataBase, sitemap.xml and robots.txt URLs.

# Google Form URL — where /join redirects to.
# Replace PLACEHOLDER with the real Google Form viewform URL.
NEXT_PUBLIC_GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/PLACEHOLDER/viewform"

# Sentry (error tracking)
# https://docs.sentry.io/platforms/javascript/guides/nextjs/
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — used by Sentry release plugin to upload sourcemaps. Not exposed at runtime.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# SMS Forwarder Secret (shared secret header for the Android app forwarder)
SMS_FORWARDER_SECRET="your_secure_random_forwarder_secret_here"



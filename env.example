# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth
# WARNING: never ship the placeholder below. Generate a long random string
# (e.g. `openssl rand -base64 32`); with a weak/known secret session tokens
# can be forged.
BETTER_AUTH_SECRET="secret_key"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Resend Email
# The from domain must be verified in Resend (Domains → add DNS records).
# An unverified sender is refused with "domain is not verified".
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="Manarat Science Club <info@manaratscience.club>"

# Supabase (for file uploads)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR_KEY]
SUPABASE_SERVICE_ROLE_KEY=

# Media CDN offload (optional). Supabase meters *cached egress* — every byte its CDN
# hands a visitor — so the syllabus/rulebook PDFs and content images are copied to a
# Tigris bucket (S3-compatible, no egress charge) by `pnpm media:migrate`. Set this to
# that bucket's public read origin (`https://<bucket>.t3.tigrisfiles.io`, or your own
# CNAME once it is bound) and `src/lib/media.ts` serves every PDF and content image from
# it; leave it unset and all URLs keep pointing at Supabase. No trailing slash.
# Set it in Vercel too, not just locally, or the deployed site still bills Supabase.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Tigris credentials. Read only by scripts/migrate-media-to-tigris.mjs — never imported
# by the app — and named the way the AWS SDK expects, because Tigris speaks S3.
# Create the access key pair in the Tigris dashboard.
AWS_ACCESS_KEY_ID=tid_xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
# Required only when the account holds more than one bucket; the name becomes part of
# every public media URL.
AWS_S3_BUCKET=

# On Vercel, set NEXT_PUBLIC_BASE_URL to your production URL (e.g. https://manaratscience.club)
# and ensure DATABASE_URL, DIRECT_URL, BETTER_AUTH_SECRET and EMAIL_FROM are all
# set in Vercel env vars.
# It also drives metadataBase, sitemap.xml and robots.txt URLs.

# Google Form URL — where /join redirects to.
# Replace PLACEHOLDER with the real Google Form viewform URL.
NEXT_PUBLIC_GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/PLACEHOLDER/viewform"

# SMS Forwarder Secret (shared secret header for the Android app forwarder)
SMS_FORWARDER_SECRET="your_secure_random_forwarder_secret_here"

# Supabase project-to-project port — NOT this file.
# `scripts/db-port-*.mjs` read only `PORT_*` names, and only from a separate gitignored
# file (`.env.port`), because this one holds the live production DSN and a port script
# must never be able to mistake it for a target. Leave PORT_SOURCE_DB blank and the
# scripts fall back to DIRECT_URL here, so the production password keeps one home.
#   PORT_SOURCE_DB, PORT_TARGET_DB (5432 session), PORT_TARGET_RUNTIME (6543),
#   PORT_TARGET_PROJECT_URL, PORT_TARGET_REF, PORT_TARGET_PUBLISHABLE_KEY,
#   PORT_TARGET_SERVICE_ROLE_KEY
# Never pass a DSN or a key on the command line — argv is visible in `ps` and build logs.
# See obsidian/backend/database-supabase.md and ADR-0042.



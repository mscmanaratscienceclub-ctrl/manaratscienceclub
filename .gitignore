# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# Supabase project-to-project port: DDL captured from the live database, row
# digests, and the reconcile ledger. The artifacts contain real user rows.
/db-port/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin
.env.local

# throwaway email render workspace
/.email-preview

# Generated bracket reports — participants' names, phone numbers and bKash
# references. Written by `pnpm reports:brackets`; artefacts, not a commit.
/reports/

# Generated infographics: the aggregate dump, the 1600×2000 sheets and their PNGs.
# Aggregates only, but still derived from the live database and re-runnable with
# `pnpm reports:infographics` + `pnpm reports:infographics:pngs`.
/infographics/

      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Rubik:wght@400;500;600;700&display=swap');\n\n  .font-display { font-family: 'Fredoka', sans-serif; }\n  .font-body { font-family: 'Rubik', sans-serif; }\n\n  :root {\n    --teal: #005f6b;\n    --yellow: #ffb703;\n    --purple: #7c3aed;\n    --pink: #ec4899;\n    --blue: #60a5fa;\n    --red: #dc2626;\n    --cream: #fff8ec;\n    --ink: #142326;\n  }\n\n  .shadow-soft { box-shadow: 0 10px 30px rgba(20,35,38,0.08); }\n  .shadow-academic { box-shadow: 0 18px 50px rgba(0,95,107,0.12); }\n\n  .dot-grid {\n    background-image: radial-gradient(rgba(0,95,107,0.18) 1.5px, transparent 1.5px);\n    background-size: 18px 18px;\n  }\n\n  .topcard { transition: box-shadow .35s ease; }\n  .topcard:hover { box-shadow: 0 18px 50px rgba(0,95,107,0.16); }\n  .topbar-accent { transform: scaleX(0); transform-origin: left; transition: transform .35s ease; }\n  .topcard:hover .topbar-accent { transform: scaleX(1); }\n  .title-link { transition: color .25s ease; }\n  .topcard:hover .title-link { color: var(--teal); }\n\n  .navlink { transition: color .2s ease; }\n  .navlink:hover { color: var(--teal); }\n\n  .join-pill { transition: background-color .25s ease, color .25s ease, transform .25s ease; }\n  .join-pill:hover { background: var(--yellow); color: var(--teal); transform: translateY(-2px); }\n\n  .chip:hover { border-color: rgba(0,95,107,.4); }\n\n  .topic-row { transition: background-color .2s ease; }\n  .topic-row:hover { background: rgba(0,95,107,.05); }\n\n  .trend-item { transition: color .2s ease; }\n  .trend-item:hover .trend-title { color: var(--teal); }\n\n  .yellow-pill { transition: transform .25s ease, box-shadow .25s ease; }\n  .yellow-pill:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(255,183,3,.4); }\n\n  .footlink { transition: color .2s ease, padding-left .2s ease; }\n  .footlink:hover { padding-left: 4px; }\n\n  .article-card.dimmed { opacity: .3; filter: saturate(.4); }\n\n  .fade-up { opacity: 0; transform: translateY(24px); }\n</style>\n\n<div class=\"font-body min-h-screen\" style=\"background: var(--cream); color: var(--ink);\" data-kid=\"1\">\n\n  \n  <nav class=\"sticky top-0 z-50 bg-white border-b\" style=\"border-color: rgba(0,95,107,.1);\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n      \n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-12 h-12 rounded-2xl flex items-center justify-center\" style=\"background: var(--teal);\" data-kid=\"5\">\n          <i data-lucide=\"atom\" class=\"text-white\" style=\"width:26px;height:26px;\" data-kid=\"6\"></i>\n        </div>\n        <div class=\"leading-tight\" data-kid=\"7\">\n          <div class=\"font-display font-bold text-lg\" style=\"color: var(--teal);\" data-kid=\"8\">Manarat</div>\n          <div class=\"font-display font-semibold text-sm\" style=\"color: var(--ink);\" data-kid=\"9\">Science Club</div>\n        </div>\n      </div>\n      \n      <div class=\"hidden lg:flex items-center gap-8 font-display font-semibold text-sm\" style=\"color: rgba(20,35,38,.7);\" data-kid=\"10\">\n        <a href=\"#\" class=\"navlink\" data-kid=\"11\">Home</a>\n        <a href=\"#\" class=\"navlink\" data-kid=\"12\">Legacy</a>\n        <a href=\"#\" class=\"navlink\" data-kid=\"13\">Achievements</a>\n        <a href=\"#\" class=\"navlink\" style=\"color: var(--teal);\" data-kid=\"14\">Research</a>\n        <a href=\"#\" class=\"navlink\" data-kid=\"15\">Events</a>\n        <a href=\"#\" class=\"navlink\" data-kid=\"16\">Opportunities</a>\n      </div>\n      \n      <div class=\"flex items-center gap-4\" data-kid=\"17\">\n        <button class=\"w-9 h-9 rounded-full border flex items-center justify-center\" style=\"border-color: rgba(0,95,107,.35);\" data-kid=\"18\">\n          <i data-lucide=\"user\" style=\"width:18px;height:
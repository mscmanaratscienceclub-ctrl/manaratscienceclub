      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Rubik:wght@400;500;600;700&display=swap');\n\n  .font-head { font-family: 'Fredoka', sans-serif; }\n  .font-body { font-family: 'Rubik', sans-serif; }\n\n  .shadow-soft { box-shadow: 0 10px 30px rgba(20,35,38,0.08); }\n  .shadow-academic { box-shadow: 0 18px 50px rgba(0,95,107,0.12); }\n\n  .card-lift { transition: transform .35s cubic-bezier(.2,.7,.3,1), box-shadow .35s ease; }\n  .card-lift:hover { transform: translateY(-6px); box-shadow: 0 18px 50px rgba(0,95,107,0.16); }\n  .img-zoom { transition: transform .5s cubic-bezier(.2,.7,.3,1); }\n  .group:hover .img-zoom { transform: scale(1.07); }\n\n  .join-pill { transition: transform .25s ease, background-color .25s ease, color .25s ease, box-shadow .25s ease; }\n  .join-pill:hover { transform: translateY(-2px); background-color: #ffb703; color: #142326; box-shadow: 0 10px 24px rgba(255,183,3,0.35); }\n\n  .chip { transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease; }\n  .chip:hover { transform: translateY(-1px); }\n\n  .nav-link { transition: color .2s ease; }\n  .nav-link:hover { color: #005f6b; }\n\n  .fade-up { opacity: 0; transform: translateY(24px); }\n  .fade-in-done { opacity: 1 !important; transform: none !important; transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.3,1); }\n\n  .card-dim { opacity: .25; filter: saturate(.6); transition: opacity .35s ease, filter .35s ease; }\n  .article-card { transition: opacity .35s ease, filter .35s ease, transform .35s cubic-bezier(.2,.7,.3,1), box-shadow .35s ease; }\n</style>\n\n<div class=\"font-body min-h-screen bg-[#fff8ec] text-[#142326] antialiased\" data-kid=\"1\">\n\n  \n  <header class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[#005f6b]/10\" data-kid=\"2\">\n    <div class=\"max-w-[1180px] mx-auto px-6 h-[72px] flex items-center justify-between gap-6\" data-kid=\"3\">\n      \n      <a href=\"#\" class=\"flex items-center gap-3 shrink-0\" data-kid=\"4\">\n        <div class=\"w-12 h-12 rounded-2xl bg-[#005f6b] flex items-center justify-center shadow-soft\" data-kid=\"5\">\n          <i data-lucide=\"atom\" class=\"text-white\" style=\"width:26px;height:26px;\" data-kid=\"6\"></i>\n        </div>\n        <div class=\"leading-tight\" data-kid=\"7\">\n          <div class=\"font-head font-bold text-[#005f6b] text-lg\" data-kid=\"8\">Manarat</div>\n          <div class=\"font-head font-semibold text-[#142326] text-xs tracking-wide\" data-kid=\"9\">Science Club</div>\n        </div>\n      </a>\n\n      \n      <nav class=\"hidden lg:flex items-center gap-8 font-head font-semibold text-sm text-[#142326]/70\" data-kid=\"10\">\n        <a href=\"#\" class=\"nav-link\" data-kid=\"11\">Home</a>\n        <a href=\"#\" class=\"nav-link\" data-kid=\"12\">Legacy</a>\n        <a href=\"#\" class=\"nav-link\" data-kid=\"13\">Achievements</a>\n        <a href=\"#\" class=\"nav-link text-[#005f6b]\" data-kid=\"14\">Research</a>\n        <a href=\"#\" class=\"nav-link\" data-kid=\"15\">Events</a>\n        <a href=\"#\" class=\"nav-link\" data-kid=\"16\">Opportunities</a>\n      </nav>\n\n      \n      <div class=\"flex items-center gap-4 shrink-0\" data-kid=\"17\">\n        <button class=\"w-9 h-9 rounded-full border-2 border-[#005f6b]/40 flex items-center justify-center text-[#005f6b] hover:bg-[#005f6b]/5 transition\" data-kid=\"18\">\n          <i data-lucide=\"user\" style=\"width:18px;height:18px;\" data-kid=\"19\"></i>\n        </button>\n        <button class=\"hidden sm:flex items-center gap-1.5 text-xs font-medium text-[#dc2626]/60 hover:text-[#dc2626] transition\" data-kid=\"20\">\n          <i data-lucide=\"bug\" style=\"width:14px;height:14px;\" data-kid=\"21\"></i>\n          Report a bug\n        </button>\n        <button class=\"join-pill font-head font-bold text-white bg-[#005f6b] rounded-full px-5 py-2.5 text-sm\" data-kid=\"22\">\n          Join MSC\n        </button>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"relative bg-gradient-to-b from-[#fff8ec] to-white\" data-kid=\"23\">\n    <div class=\"max-w-[1180px] mx-auto px-6 pt-20 pb-16 text-center\" data-kid=\"24\">\n      <div class=\"fade-up inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#005f6b]/8 text-[#005f6b] font-head font-medium text-xs mb-7\" data-kid=\"25\">\n        <i data-lucide=\"sparkles\" style=\"width:14px;height:14px;\" data-kid=\"26\"></i>\n        Knowledge Hub\n      </div>\n      <h1 class=\"fade-up font-head font-bold text-[#142326] text-5xl md:text-6xl tracking-tight leading-[1.05]\" data-kid=\"27\">\n        Research &amp; <span class=\"text-[#005f6b]\" data-kid=\"28\">Articles</span>\n      </h1>\n      <div class=\"fade-up mx-auto mt-6 mb-6 w-16 h-[3px] rounded-full bg-[#ffb703]\" data-kid=\"29\"></div>\n      <p class=\"fade-up mx-auto max-w-2xl text-[#142326]/60 text-lg leading-relaxed\" data-kid=\"30\">\n        Discover scientific publications, research findings, and insightful articles authored by Manarat Science Club members.\n      </p>\n    </div>\n  </section>\n\n  \n  <div class=\"sticky top-[72px] z-40 bg-white/85 backdrop-blur-md border-b border-[#005f6b]/10\" data-kid=\"31\">\n    <div class=\"max-w-[1180px] mx-auto px-6 py-4 flex flex-col lg:flex-row lg:items-center gap-4 justify-between\" data-kid=\"32\">\n      \n      <div id=\"chipRow\" class=\"flex flex-wrap items-center gap-2\" data-kid=\"33\">\n        <button data-filter=\"all\" class=\"chip active font-head font-medium text-sm rounded-full px-4 py-2 bg-[#005f6b] text-white border border-[#005f6b]\" data-kid=\"34\">All</button>\n        <button data-filter=\"physics\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"35\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#60a5fa\" data-kid=\"36\"></span>Physics</button>\n        <button data-filter=\"astronomy\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"37\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#7c3aed\" data-kid=\"38\"></span>Astronomy</button>\n        <button data-filter=\"biology\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"39\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#22a06b\" data-kid=\"40\"></span>Biology</button>\n        <button data-filter=\"chemistry\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"41\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#ec4899\" data-kid=\"42\"></span>Chemistry</button>\n        <button data-filter=\"robotics\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"43\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#ffb703\" data-kid=\"44\"></span>Robotics</button>\n        <button data-filter=\"mathematics\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"45\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#dc2626\" data-kid=\"46\"></span>Mathematics</button>\n        <button data-filter=\"environment\" class=\"chip font-head font-medium text-sm rounded-full px-4 py-2 bg-white border border-[#005f6b]/15 text-[#142326]/70 flex items-center gap-2\" data-kid=\"47\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#005f6b\" data-kid=\"48\"></span>Environment</button>\n      </div>\n      \n      <div class=\"relative shrink-0 lg:w-72\" data-kid=\"49\">\n        <i data-lucide=\"search\" class=\"absolute left-4 top-1/2 -translate-y-1/2 text-[#005f6b]\" style=\"width:18px;height:18px;\" data-kid=\"50\"></i>\n        <input id=\"searchInput\" type=\"text\" placeholder=\"Search articles...\" class=\"w-full font-body text-sm rounded-full bg-[#fff8ec] border border-[#005f6b]/15 pl-11 pr-4 py-2.5 text-[#142326] placeholder:text-[#142326]/40 focus:outline-none focus:border-[#005f6b]/40 focus:bg-white transition\" data-kid=\"51\">\n      </div>\n    </div>\n  </div>\n\n  \n  <main class=\"bg-[#fff8ec]\" data-kid=\"52\">\n    <div class=\"max-w-[1180px] mx-auto px-6 py-14\" data-kid=\"53\">\n\n      \n      <div class=\"fade-up flex items-center gap-3 mb-6\" data-kid=\"54\">\n        <span class=\"w-2.5 h-2.5 rounded-full bg-[#ffb703]\" data-kid=\"55\"></span>\n        <h2 class=\"font-head font-bold text-xl text-[#142326]\" data-kid=\"56\">Featured</h2>\n        <div class=\"flex-1 h-px bg-[#005f6b]/10\" data-kid=\"57\"></div>\n      </div>\n\n      <article class=\"fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-academic grid md:grid-cols-2 mb-16\" data-kid=\"58\">\n        <div class=\"relative overflow-hidden md:rounded-l-2xl\" data-kid=\"59\">\n          <img src=\"https://images.unsplash.com/photo-1564325724739-bae0bd08762c?auto=format&w=900&q=80&fit=crop\" alt=\"Light refracting and dispersing into a spectrum through glass\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full h-64 md:h-full object-cover aspect-[16/10]\" data-kid=\"60\">\n        </div>\n        <div class=\"p-8 md:p-10 flex flex-col justify-center\" data-kid=\"61\">\n          <span class=\"self-start inline-flex items-center gap-1.5 text-xs font-head font-semibold px-3 py-1 rounded-full mb-4\" style=\"background:#60a5fa1f;color:#2563eb\" data-kid=\"62\"><span class=\"w-1.5 h-1.5 rounded-full\" style=\"background:#60a5fa\" data-kid=\"63\"></span>Physics</span>\n          <h3 class=\"font-head font-bold text-2xl md:text-3xl text-[#142326] leading-snug group-hover:text-[#005f6b] transition\" data-kid=\"64\">Bending Light: A Student Study of Refraction</h3>\n          <p class=\"text-[#142326]/60 mt-3 leading-relaxed\" data-kid=\"65\">An experimental investigation into how light bends across media of varying density — measuring refractive indices with everyday lab tools and surprising precision.</p>\n          <div class=\"flex flex-wrap items-center gap-x-5 gap-y-2 mt-6 text-sm text-[#142326]/50\" data-kid=\"66\">\n            <span class=\"flex items-center gap-1.5\" data-kid=\"67\"><i data-lucide=\"user-round\" style=\"width:15px;height:15px;\" data-kid=\"68\"></i>Abrar Rahman</span>\n            <span class=\"flex items-center gap-1.5\" data-kid=\"69\"><i data-lucide=\"calendar-days\" style=\"width:15px;height:15px;\" data-kid=\"70\"></i>Jun 21, 2026</span>\n            <span class=\"flex items-center gap-1.5\" data-kid=\"71\"><i data-lucide=\"clock\" style=\"width:15px;height:15px;\" data-kid=\"72\"></i>6 min read</span>\n          </div>\n          <div class=\"flex flex-wrap gap-2 mt-5\" data-kid=\"73\">\n            <span class=\"text-xs font-medium px-3 py-1 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"74\">Optics</span>\n            <span class=\"text-xs font-medium px-3 py-1 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"75\">Experiment</span>\n            <span class=\"text-xs font-medium px-3 py-1 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"76\">Lab Study</span>\n          </div>\n        </div>\n      </article>\n\n      \n      <div class=\"fade-up flex items-center gap-3 mb-7\" data-kid=\"77\">\n        <span class=\"w-2.5 h-2.5 rounded-full bg-[#005f6b]\" data-kid=\"78\"></span>\n        <h2 class=\"font-head font-bold text-xl text-[#142326]\" data-kid=\"79\">All Articles</h2>\n        <div class=\"flex-1 h-px bg-[#005f6b]/10\" data-kid=\"80\"></div>\n        <span id=\"resultCount\" class=\"text-sm text-[#142326]/40 font-body\" data-kid=\"81\">9 articles</span>\n      </div>\n\n      <div id=\"grid\" class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\" data-kid=\"82\">\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"astronomy\" data-text=\"mapping the night sky nadia hossain stars constellations\" data-kid=\"83\">\n          <div class=\"relative overflow-hidden\" data-kid=\"84\">\n            <img src=\"https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?auto=format&w=800&q=80&fit=crop\" alt=\"Star-filled night sky\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"85\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#7c3aed\" data-kid=\"86\">Astronomy</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"87\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"88\">Mapping the Night Sky from a Rooftop Observatory</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"89\">Cataloguing constellations and tracking planetary motion using a modest student telescope over one semester.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"90\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"91\">Nadia Hossain · May 14, 2026 · 5 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"92\">Stars</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"biology\" data-text=\"microbial life pond water samin chowdhury microscope cells\" data-kid=\"93\">\n          <div class=\"relative overflow-hidden\" data-kid=\"94\">\n            <img src=\"https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&w=800&q=80&fit=crop\" alt=\"Scientist looking through a microscope\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"95\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#22a06b\" data-kid=\"96\">Biology</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"97\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"98\">Microbial Life Hidden in Local Pond Water</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"99\">A microscopy survey of single-celled organisms revealing surprising biodiversity in nearby freshwater.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"100\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"101\">Samin Chowdhury · Apr 02, 2026 · 7 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"102\">Cells</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"chemistry\" data-text=\"reaction rates colour change tahmid islam beakers titration\" data-kid=\"103\">\n          <div class=\"relative overflow-hidden\" data-kid=\"104\">\n            <img src=\"https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&w=800&q=80&fit=crop\" alt=\"Colorful chemistry beakers and flasks\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"105\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#ec4899\" data-kid=\"106\">Chemistry</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"107\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"108\">The Colour of Chemistry: Visualising Reaction Rates</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"109\">Using indicator dyes to make invisible kinetics visible, timing reactions by the moment their colour shifts.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"110\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"111\">Tahmid Islam · Mar 19, 2026 · 4 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"112\">Kinetics</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"robotics\" data-text=\"line following robot rafi ahmed arduino sensors autonomous\" data-kid=\"113\">\n          <div class=\"relative overflow-hidden\" data-kid=\"114\">\n            <img src=\"https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&w=800&q=80&fit=crop\" alt=\"Robot with circuitry\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"115\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#b88300\" data-kid=\"116\">Robotics</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"117\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"118\">Building an Autonomous Line-Following Robot</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"119\">From infrared sensors to PID tuning — engineering a small bot that navigates a track entirely on its own.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"120\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"121\">Rafi Ahmed · Feb 27, 2026 · 8 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"122\">Arduino</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"mathematics\" data-text=\"fibonacci patterns nature ayesha karim equations golden ratio\" data-kid=\"123\">\n          <div class=\"relative overflow-hidden\" data-kid=\"124\">\n            <img src=\"https://images.unsplash.com/photo-1635070041078-e363dbe005cb?auto=format&w=800&q=80&fit=crop\" alt=\"Mathematical equations written on a board\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"125\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#dc2626\" data-kid=\"126\">Mathematics</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"127\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"128\">The Golden Ratio Hiding in Everyday Patterns</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"129\">Tracing Fibonacci sequences and φ through seashells, sunflowers, and architecture around campus.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"130\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"131\">Ayesha Karim · Feb 09, 2026 · 6 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"132\">Patterns</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"environment\" data-text=\"urban air quality monitoring zayan haque sensors pollution green\" data-kid=\"133\">\n          <div class=\"relative overflow-hidden\" data-kid=\"134\">\n            <img src=\"https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&w=800&q=80&fit=crop\" alt=\"Sunlight through a green forest\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"135\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#005f6b\" data-kid=\"136\">Environment</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"137\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"138\">Monitoring Urban Air Quality with Low-Cost Sensors</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"139\">A month-long study tracking particulate levels across the city using DIY sensor stations and open data.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"140\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"141\">Zayan Haque · Jan 25, 2026 · 5 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"142\">Climate</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"physics\" data-text=\"pendulum motion energy maria sultana harmonic experiment\" data-kid=\"143\">\n          <div class=\"relative overflow-hidden\" data-kid=\"144\">\n            <img src=\"https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&w=800&q=80&fit=crop\" alt=\"Physics laboratory equipment\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"145\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#2563eb\" data-kid=\"146\">Physics</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"147\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"148\">Simple Harmonic Motion in a Backyard Pendulum</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"149\">Measuring period, gravity, and energy loss with nothing more than string, a weight, and a smartphone timer.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"150\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"151\">Maria Sultana · Jan 11, 2026 · 4 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"152\">Mechanics</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"astronomy\" data-text=\"galaxy classification imran sadek deep field nebula space\" data-kid=\"153\">\n          <div class=\"relative overflow-hidden\" data-kid=\"154\">\n            <img src=\"https://images.unsplash.com/photo-1462331940025-496dfbfc7564?auto=format&w=800&q=80&fit=crop\" alt=\"Distant galaxy in deep space\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"155\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#7c3aed\" data-kid=\"156\">Astronomy</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"157\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"158\">Classifying Galaxies from Public Telescope Data</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"159\">Sorting spirals, ellipticals and irregulars from open survey images to understand cosmic structure.</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"160\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"161\">Imran Sadek · Dec 18, 2026 · 9 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"162\">Cosmos</span>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"article-card fade-up card-lift group bg-white rounded-2xl overflow-hidden shadow-soft\" data-tags=\"test\" data-text=\"dejavu it works abrar test\" data-kid=\"163\">\n          <div class=\"relative overflow-hidden\" data-kid=\"164\">\n            <img src=\"https://images.unsplash.com/photo-1554475901-4538ddfbccc2?auto=format&w=800&q=80&fit=crop\" alt=\"Open notebook with science notes\" decoding=\"async\" loading=\"lazy\" class=\"img-zoom w-full aspect-[16/10] object-cover\" data-kid=\"165\">\n            <span class=\"absolute top-3 left-3 text-xs font-head font-semibold px-3 py-1 rounded-full bg-white/90 backdrop-blur\" style=\"color:#005f6b\" data-kid=\"166\">test</span>\n          </div>\n          <div class=\"p-5\" data-kid=\"167\">\n            <h3 class=\"font-head font-bold text-lg text-[#142326] leading-snug line-clamp-2 group-hover:text-[#005f6b] transition\" data-kid=\"168\">dejavu</h3>\n            <p class=\"text-sm text-[#142326]/60 mt-2 line-clamp-2\" data-kid=\"169\">it works</p>\n            <div class=\"flex items-center justify-between mt-4 pt-4 border-t border-[#142326]/8\" data-kid=\"170\">\n              <span class=\"text-xs text-[#142326]/40\" data-kid=\"171\">abrar · Jun 21, 2026 · 1 min</span>\n              <span class=\"text-[11px] font-medium px-2 py-0.5 rounded-full bg-[#005f6b]/10 text-[#005f6b]\" data-kid=\"172\">test</span>\n            </div>\n          </div>\n        </article>\n\n      </div>\n\n      \n      <div id=\"emptyState\" class=\"hidden text-center py-20\" data-kid=\"173\">\n        <div class=\"w-16 h-16 rounded-2xl bg-[#005f6b]/8 flex items-center justify-center mx-auto mb-4\" data-kid=\"174\">\n          <i data-lucide=\"search-x\" class=\"text-[#005f6b]\" style=\"width:28px;height:28px;\" data-kid=\"175\"></i>\n        </div>\n        <p class=\"font-head font-semibold text-lg text-[#142326]\" data-kid=\"176\">No articles found</p>\n        <p class=\"text-[#142326]/50 text-sm mt-1\" data-kid=\"177\">Try a different topic or search term.</p>\n      </div>\n\n    </div>\n  </main>\n\n  \n  <footer class=\"bg-white border-t border-[#005f6b]/20\" data-kid=\"178\">\n    <div class=\"max-w-[1180px] mx-auto px-6 py-14\" data-kid=\"179\">\n      <div class=\"grid md:grid-cols-3 gap-6\" data-kid=\"180\">\n\n        \n        <div class=\"rounded-2xl p-7 bg-[#005f6b]/6\" data-kid=\"181\">\n          <h4 class=\"font-head font-bold text-lg text-[#005f6b] mb-5 flex items-center gap-2\" data-kid=\"182\"><i data-lucide=\"map-pin\" style=\"width:18px;height:18px;\" data-kid=\"183\"></i>Contact</h4>\n          <ul class=\"space-y-3 text-sm text-[#142326]/70\" data-kid=\"184\">\n            <li class=\"flex items-center gap-3\" data-kid=\"185\"><i data-lucide=\"map-pin\" class=\"text-[#005f6b] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"186\"></i>Manarat Dhaka Int'l School &amp; College, Dhaka</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"187\"><i data-lucide=\"mail\" class=\"text-[#005f6b] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"188\"></i>scienceclub@manarat.edu</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"189\"><i data-lucide=\"phone\" class=\"text-[#005f6b] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"190\"></i>+880 1700 000000</li>\n          </ul>\n        </div>\n\n        \n        <div class=\"rounded-2xl p-7 bg-[#7c3aed]/6\" data-kid=\"191\">\n          <h4 class=\"font-head font-bold text-lg text-[#7c3aed] mb-5 flex items-center gap-2\" data-kid=\"192\"><i data-lucide=\"compass\" style=\"width:18px;height:18px;\" data-kid=\"193\"></i>Explore</h4>\n          <ul class=\"grid grid-cols-2 gap-x-4 gap-y-3 text-sm text-[#142326]/70\" data-kid=\"194\">\n            <li data-kid=\"195\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"196\">Home</a></li>\n            <li data-kid=\"197\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"198\">Institutional Legacy</a></li>\n            <li data-kid=\"199\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"200\">Achievements &amp; Accolades</a></li>\n            <li data-kid=\"201\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"202\">Research Hub</a></li>\n            <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"204\">Events Calendar</a></li>\n            <li data-kid=\"205\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"206\">Teams &amp; Projects</a></li>\n            <li data-kid=\"207\"><a href=\"#\" class=\"hover:text-[#7c3aed] transition\" data-kid=\"208\">Join MSC</a></li>\n          </ul>\n        </div>\n\n        \n        <div class=\"rounded-2xl p-7 bg-[#dc2626]/6\" data-kid=\"209\">\n          <h4 class=\"font-head font-bold text-lg text-[#dc2626] mb-5 flex items-center gap-2\" data-kid=\"210\"><i data-lucide=\"users\" style=\"width:18px;height:18px;\" data-kid=\"211\"></i>Community</h4>\n          <ul class=\"space-y-3 text-sm text-[#142326]/70\" data-kid=\"212\">\n            <li class=\"flex items-center gap-3\" data-kid=\"213\"><i data-lucide=\"instagram\" class=\"text-[#dc2626] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"214\"></i>Instagram</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"215\"><i data-lucide=\"message-circle\" class=\"text-[#dc2626] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"216\"></i>Discord</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"217\"><i data-lucide=\"facebook\" class=\"text-[#dc2626] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"218\"></i>Facebook</li>\n            <li class=\"flex items-center gap-3 pt-2 border-t border-[#dc2626]/10 mt-2\" data-kid=\"219\"><i data-lucide=\"users\" class=\"text-[#dc2626] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"220\"></i>Brothers Group</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"221\"><i data-lucide=\"users\" class=\"text-[#dc2626] shrink-0\" style=\"width:16px;height:16px;\" data-kid=\"222\"></i>Sisters Group</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"mt-8 rounded-xl bg-[#005f6b]/5 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-[#142326]/50 text-center\" data-kid=\"223\">\n        <span data-kid=\"224\">© 2026 Manarat Science Club — Manarat Dhaka International School &amp; College. All rights reserved.</span>\n        <span data-kid=\"225\">Designed &amp; built by the MSC Web Team</span>\n      </div>\n    </div>\n  </footer>\n\n</div>\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"226\"></script>\n<script data-kid=\"227\">\n  lucide.createIcons();\n\n  // Fade-up on load (staggered)\n  const fades = document.querySelectorAll('.fade-up');\n  const io = new IntersectionObserver((entries) => {\n    entries.forEach((e, i) => {\n      if (e.isIntersecting) {\n        const el = e.target;\n        setTimeout(() => el.classList.add('fade-in-done'), (Array.from(fades).indexOf(el) % 6) * 70);\n        io.unobserve(el);\n      }\n    });\n  }, { threshold: 0.1 });\n  fades.forEach(f => io.observe(f));\n\n  // Filtering\n  const chips = document.querySelectorAll('#chipRow .chip');\n  const cards = document.querySelectorAll('.article-card');\n  const searchInput = document.getElementById('searchInput');\n  const emptyState = document.getElementById('emptyState');\n  const resultCount = document.getElementById('resultCount');\n  let activeFilter = 'all';\n\n  function applyFilters() {\n    const q = searchInput.value.trim().toLowerCase();\n    let visible = 0;\n    cards.forEach(card => {\n      const tags = card.getAttribute('data-tags') || '';\n      const text = (card.getAttribute('data-text') || '') + ' ' + card.textContent.toLowerCase();\n      const matchTag = activeFilter === 'all' || tags.includes(activeFilter);\n      const matchSearch = !q || text.toLowerCase().includes(q);\n      if (matchTag && matchSearch) {\n        card.style.display = '';\n        card.classList.remove('card-dim');\n        visible++;\n      } else {\n        card.style.display = 'none';\n      }\n    });\n    emptyState.classList.toggle('hidden', visible !== 0);\n    resultCount.textContent = visible + (visible === 1 ? ' article' : ' articles');\n  }\n\n  chips.forEach(chip => {\n    chip.addEventListener('click', () => {\n      activeFilter = chip.getAttribute('data-filter');\n      chips.forEach(c => {\n        c.classList.remove('active', 'bg-[#005f6b]', 'text-white', 'border-[#005f6b]');\n        c.classList.add('bg-white', 'border-[#005f6b]/15', 'text-[#142326]/70');\n      });\n      chip.classList.add('active', 'bg-[#005f6b]', 'text-white', 'border-[#005f6b]');\n      chip.classList.remove('bg-white', 'border-[#005f6b]/15', 'text-[#142326]/70');\n      applyFilters();\n    });\n  });\n\n  searchInput.addEventListener('input', applyFilters);\n</script>",

      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Rubik:wght@400;500;600;700&display=swap');\n\n  .font-display { font-family: 'Fredoka', sans-serif; }\n  .font-body { font-family: 'Rubik', sans-serif; }\n\n  :root{\n    --teal:#005f6b; --yellow:#ffb703; --purple:#7c3aed; --pink:#ec4899;\n    --blue:#60a5fa; --red:#dc2626; --cream:#fff8ec; --ink:#142326; --white:#ffffff;\n  }\n\n  .shadow-subtle{ box-shadow:0 10px 30px rgba(20,35,38,0.08); }\n  .shadow-academic{ box-shadow:0 18px 50px rgba(0,95,107,0.12); }\n\n  .dotgrid{\n    background-image:radial-gradient(rgba(0,95,107,0.10) 1.4px, transparent 1.4px);\n    background-size:20px 20px;\n  }\n\n  .chip-scroll::-webkit-scrollbar{ height:0; }\n\n  .card-accent{ transform:scaleX(0); transform-origin:left; transition:transform .35s ease; }\n  .group:hover .card-accent{ transform:scaleX(1); }\n\n  .article-dim{ opacity:.28; filter:saturate(.6); }\n\n  .nav-link{ position:relative; }\n  .nav-link::after{\n    content:\"\"; position:absolute; left:0; bottom:-6px; height:2px; width:0;\n    background:var(--teal); border-radius:9px; transition:width .3s ease;\n  }\n  .nav-link:hover::after{ width:100%; }\n\n  .join-btn{ transition:transform .25s ease, background-color .25s ease, color .25s ease; }\n  .join-btn:hover{ transform:translateY(-2px); background:var(--yellow); color:var(--teal); }\n\n  .fade-up{ opacity:0; transform:translateY(22px); }\n\n  .article-card{ transition:none !important; }\n  .article-card.anim-done{ transition:transform .3s ease, box-shadow .3s ease !important; }\n</style>\n\n<div class=\"font-body min-h-screen\" style=\"background:var(--cream); color:var(--ink);\" data-kid=\"1\">\n\n  \n  <header class=\"sticky top-0 z-50 bg-white\" style=\"border-bottom:1px solid rgba(0,95,107,0.10);\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-6 h-[72px] flex items-center justify-between\" data-kid=\"3\">\n      \n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-12 h-12 rounded-2xl flex items-center justify-center shrink-0\" style=\"background:var(--teal);\" data-kid=\"5\">\n          <i data-lucide=\"atom\" class=\"text-white\" style=\"width:24px;height:24px;\" data-kid=\"6\"></i>\n        </div>\n        <div class=\"leading-tight\" data-kid=\"7\">\n          <div class=\"font-display font-bold text-lg\" style=\"color:var(--teal);\" data-kid=\"8\">Manarat</div>\n          <div class=\"font-display font-semibold text-sm -mt-1\" style=\"color:var(--ink);\" data-kid=\"9\">Science Club</div>\n        </div>\n      </div>\n\n      \n      <nav class=\"hidden lg:flex items-center gap-8 font-display font-semibold text-sm\" data-kid=\"10\">\n        <a href=\"#\" class=\"nav-link\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"11\">Home</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"12\">Legacy</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"13\">Achievements</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:var(--teal);\" data-kid=\"14\">Research</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"15\">Events</a>\n        <a href=\"#\" class=\"nav-link\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"16\">Opportunities</a>\n      </nav>\n\n      \n      <div class=\"flex items-center gap-4\" data-kid=\"17\">\n        <button class=\"w-9 h-9 rounded-full border flex items-center justify-center hover:bg-[var(--teal)] hover:text-white transition-colors\" style=\"border:1.5px solid var(--teal); color:var(--teal);\" data-kid=\"18\">\n          <i data-lucide=\"user\" style=\"width:16px;height:16px;\" data-kid=\"19\"></i>\n        </button>\n        <a href=\"#\" class=\"hidden sm:flex items-center gap-1 text-xs\" style=\"color:rgba(220,38,38,0.6);\" data-kid=\"20\">\n          <i data-lucide=\"bug\" style=\"width:13px;height:13px;\" data-kid=\"21\"></i> Report a bug\n        </a>\n        <button class=\"join-btn font-display font-bold rounded-full px-6 py-2.5 text-white text-sm\" style=\"background:var(--teal);\" data-kid=\"22\">Join MSC</button>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"relative bg-white overflow-hidden\" data-kid=\"23\">\n    <div class=\"absolute inset-0 dotgrid opacity-70\" style=\"mask-image:radial-gradient(ellipse 70% 80% at 50% 30%, black, transparent 75%); -webkit-mask-image:radial-gradient(ellipse 70% 80% at 50% 30%, black, transparent 75%);\" data-kid=\"24\"></div>\n    <div class=\"relative max-w-3xl mx-auto px-6 pt-20 pb-24 text-center\" data-kid=\"25\">\n      <span class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-display font-semibold mb-7\" style=\"background:rgba(0,95,107,0.07); color:var(--teal);\" data-kid=\"26\">\n        <i data-lucide=\"flask-conical\" style=\"width:14px;height:14px;\" data-kid=\"27\"></i> Knowledge Hub\n      </span>\n      <h1 class=\"font-display font-bold leading-none text-6xl md:text-7xl mb-6\" style=\"color:var(--ink);\" data-kid=\"28\">\n        Research &amp; <span class=\"relative inline-block\" style=\"color:var(--teal);\" data-kid=\"29\">Articles\n          <svg class=\"absolute -bottom-2 left-0 w-full\" height=\"10\" viewBox=\"0 0 200 10\" preserveAspectRatio=\"none\" data-kid=\"30\"><path d=\"M2 7 Q 100 1 198 6\" stroke=\"#ffb703\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" data-kid=\"31\"></path></svg>\n        </span>\n      </h1>\n      <p class=\"font-body text-base md:text-lg max-w-2xl mx-auto\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"32\">\n        Discover scientific publications, research findings, and insightful articles authored by Manarat Science Club members.\n      </p>\n\n      <div class=\"flex flex-wrap items-center justify-center gap-3 mt-9\" data-kid=\"33\">\n        <span class=\"px-4 py-2 rounded-full text-sm font-display font-medium bg-white\" style=\"border:1.5px solid rgba(0,95,107,0.15); color:rgba(20,35,38,0.7);\" data-kid=\"34\"><b style=\"color:var(--teal);\" data-kid=\"35\">24</b> Articles</span>\n        <span class=\"px-4 py-2 rounded-full text-sm font-display font-medium bg-white\" style=\"border:1.5px solid rgba(0,95,107,0.15); color:rgba(20,35,38,0.7);\" data-kid=\"36\"><b style=\"color:var(--teal);\" data-kid=\"37\">8</b> Authors</span>\n        <span class=\"px-4 py-2 rounded-full text-sm font-display font-medium bg-white\" style=\"border:1.5px solid rgba(0,95,107,0.15); color:rgba(20,35,38,0.7);\" data-kid=\"38\"><b style=\"color:var(--teal);\" data-kid=\"39\">6</b> Topics</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <main class=\"max-w-7xl mx-auto px-6 pt-12 pb-20\" data-kid=\"40\">\n\n    \n    <div class=\"flex flex-col lg:flex-row lg:items-center gap-4 mb-12\" data-kid=\"41\">\n      <div id=\"filterBar\" class=\"chip-scroll flex items-center gap-2.5 overflow-x-auto flex-1 pb-1\" data-kid=\"42\">\n        <button data-filter=\"all\" class=\"filter-chip active shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2\" data-kid=\"43\">All <span class=\"opacity-60\" data-kid=\"44\">24</span></button>\n        <button data-filter=\"Physics\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"45\"><span class=\"w-2 h-2 rounded-full\" style=\"background:var(--yellow);\" data-kid=\"46\"></span>Physics <span class=\"opacity-50\" data-kid=\"47\">5</span></button>\n        <button data-filter=\"Astronomy\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"48\"><span class=\"w-2 h-2 rounded-full\" style=\"background:var(--blue);\" data-kid=\"49\"></span>Astronomy <span class=\"opacity-50\" data-kid=\"50\">4</span></button>\n        <button data-filter=\"Biology\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"51\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#16a34a;\" data-kid=\"52\"></span>Biology <span class=\"opacity-50\" data-kid=\"53\">3</span></button>\n        <button data-filter=\"Chemistry\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"54\"><span class=\"w-2 h-2 rounded-full\" style=\"background:var(--pink);\" data-kid=\"55\"></span>Chemistry <span class=\"opacity-50\" data-kid=\"56\">4</span></button>\n        <button data-filter=\"Robotics\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"57\"><span class=\"w-2 h-2 rounded-full\" style=\"background:var(--purple);\" data-kid=\"58\"></span>Robotics <span class=\"opacity-50\" data-kid=\"59\">3</span></button>\n        <button data-filter=\"Mathematics\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"60\"><span class=\"w-2 h-2 rounded-full\" style=\"background:var(--red);\" data-kid=\"61\"></span>Mathematics <span class=\"opacity-50\" data-kid=\"62\">2</span></button>\n        <button data-filter=\"Environment\" class=\"filter-chip shrink-0 px-4 py-2 rounded-full text-sm font-display font-medium flex items-center gap-2 bg-white\" data-kid=\"63\"><span class=\"w-2 h-2 rounded-full\" style=\"background:#0d9488;\" data-kid=\"64\"></span>Environment <span class=\"opacity-50\" data-kid=\"65\">3</span></button>\n      </div>\n      <div class=\"relative lg:w-64 shrink-0\" data-kid=\"66\">\n        <i data-lucide=\"search\" class=\"absolute left-4 top-1/2 -translate-y-1/2\" style=\"width:16px;height:16px;color:rgba(20,35,38,0.4);\" data-kid=\"67\"></i>\n        <input type=\"text\" placeholder=\"Search articles...\" class=\"w-full bg-white rounded-full pl-11 pr-4 py-2.5 text-sm font-body outline-none focus:ring-2 transition\" style=\"border:1.5px solid rgba(0,95,107,0.15); color:var(--ink);\" data-kid=\"68\">\n      </div>\n    </div>\n\n    \n    <h2 class=\"font-display font-bold text-3xl mb-5 flex items-center gap-3\" style=\"color:var(--ink);\" data-kid=\"69\"><span class=\"inline-block w-1.5 h-7 rounded-full\" style=\"background:var(--yellow);\" data-kid=\"70\"></span>Featured</h2>\n    <article data-tags=\"Physics\" class=\"article-card group relative bg-white rounded-2xl shadow-subtle overflow-hidden mb-16 cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" data-kid=\"71\">\n      <div class=\"h-1.5 w-full\" style=\"background:var(--teal);\" data-kid=\"72\"></div>\n      <div class=\"p-8 md:p-10 flex flex-col md:flex-row gap-8 items-start\" data-kid=\"73\">\n        <div class=\"flex-1\" data-kid=\"74\">\n          <div class=\"flex items-center gap-2 mb-4\" data-kid=\"75\">\n            <span class=\"px-3 py-1 rounded-full text-xs font-display font-semibold\" style=\"background:rgba(255,183,3,0.15); color:#b27a00;\" data-kid=\"76\">Physics</span>\n            <span class=\"px-3 py-1 rounded-full text-xs font-display font-semibold\" style=\"background:rgba(0,95,107,0.08); color:var(--teal);\" data-kid=\"77\">Featured</span>\n          </div>\n          <h3 class=\"font-display font-bold text-3xl md:text-4xl leading-tight mb-3 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"78\">Bending Light: A Student Study of Refraction</h3>\n          <p class=\"font-body text-base mb-7 max-w-2xl\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"79\">A hands-on investigation into how light bends across different media. Students measured refractive indices using laser apparatus and compared results against Snell's Law predictions.</p>\n          <div class=\"flex flex-wrap items-center gap-x-6 gap-y-3\" data-kid=\"80\">\n            <span class=\"flex items-center gap-2 text-sm\" style=\"color:rgba(20,35,38,0.65);\" data-kid=\"81\"><i data-lucide=\"user-round\" style=\"width:16px;height:16px;color:var(--teal);\" data-kid=\"82\"></i>Abrar Rahman</span>\n            <span class=\"flex items-center gap-2 text-sm\" style=\"color:rgba(20,35,38,0.65);\" data-kid=\"83\"><i data-lucide=\"calendar-days\" style=\"width:16px;height:16px;color:var(--teal);\" data-kid=\"84\"></i>Jun 21, 2026</span>\n            <span class=\"flex items-center gap-2 text-sm\" style=\"color:rgba(20,35,38,0.65);\" data-kid=\"85\"><i data-lucide=\"clock\" style=\"width:16px;height:16px;color:var(--teal);\" data-kid=\"86\"></i>6 min read</span>\n            <div class=\"flex items-center gap-2 md:ml-auto\" data-kid=\"87\">\n              <span class=\"px-3 py-1 rounded-full text-xs font-medium\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"88\">Physics</span>\n              <span class=\"px-3 py-1 rounded-full text-xs font-medium\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"89\">Optics</span>\n            </div>\n          </div>\n        </div>\n        <div class=\"relative w-28 h-28 rounded-2xl flex items-center justify-center shrink-0 order-first md:order-last overflow-hidden\" style=\"background:rgba(0,95,107,0.08);\" data-kid=\"90\">\n          <span class=\"absolute w-24 h-24 rounded-full border-2\" style=\"border-color:rgba(0,95,107,0.12);\" data-kid=\"91\"></span>\n          <span class=\"absolute w-16 h-16 rounded-full border-2 border-dashed\" style=\"border-color:rgba(255,183,3,0.45);\" data-kid=\"92\"></span>\n          <span class=\"absolute top-3 right-5 w-2.5 h-2.5 rounded-full\" style=\"background:var(--yellow);\" data-kid=\"93\"></span>\n          <span class=\"absolute bottom-4 left-4 w-1.5 h-1.5 rounded-full\" style=\"background:var(--teal);\" data-kid=\"94\"></span>\n          <i data-lucide=\"book-open\" style=\"width:34px;height:34px;color:var(--teal);\" class=\"relative z-10\" data-kid=\"95\"></i>\n        </div>\n      </div>\n    </article>\n\n    \n    <h2 class=\"font-display font-bold text-3xl mb-6 flex items-center gap-3\" style=\"color:var(--ink);\" data-kid=\"96\"><span class=\"inline-block w-1.5 h-7 rounded-full\" style=\"background:var(--teal);\" data-kid=\"97\"></span>All Articles</h2>\n    <div id=\"articleGrid\" class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\" data-kid=\"98\">\n\n      \n      \n      <article data-tags=\"Astronomy\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"99\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--blue);\" data-kid=\"100\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(96,165,250,0.16); color:#2563eb;\" data-kid=\"101\">Astronomy</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"102\">Mapping the Night Sky: A Beginner's Star Catalogue</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"103\">Members logged 60 visible stars over three observation nights, cross-referencing magnitudes and constellations to build a club star catalogue.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"104\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"105\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"106\">Naila Karim</span> · May 14, 2026 · 5 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"107\">Stars</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Chemistry\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"108\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--pink);\" data-kid=\"109\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(236,72,153,0.14); color:#be185d;\" data-kid=\"110\">Chemistry</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"111\">The Colour of Reactions: Exploring pH Indicators</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"112\">Using red cabbage extract, students built a homemade universal indicator and tested everyday household substances across the pH scale.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"113\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"114\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"115\">Tahmid Hasan</span> · Apr 02, 2026 · 4 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"116\">pH</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Robotics\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"117\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--purple);\" data-kid=\"118\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(124,58,237,0.13); color:#6d28d9;\" data-kid=\"119\">Robotics</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"120\">Building a Line-Following Robot from Scratch</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"121\">A step-by-step account of designing an Arduino-powered robot that tracks a path using infrared sensors and a PID control loop.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"122\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"123\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"124\">Rafsan Jamil</span> · Mar 28, 2026 · 7 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"125\">Arduino</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Biology\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"126\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:#16a34a;\" data-kid=\"127\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(22,163,74,0.13); color:#15803d;\" data-kid=\"128\">Biology</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"129\">Microbes in Pond Water: A Microscopy Diary</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"130\">Observations of single-celled organisms collected from the campus pond, documented with sketches and 400x microscope photography.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"131\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"132\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"133\">Sumaiya Akter</span> · Feb 19, 2026 · 5 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"134\">Cells</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Physics\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"135\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--yellow);\" data-kid=\"136\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(255,183,3,0.18); color:#b27a00;\" data-kid=\"137\">Physics</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"138\">Pendulums &amp; Period: Measuring Gravity at School</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"139\">By timing simple pendulums of varying lengths, students estimated the local value of g and analysed sources of experimental error.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"140\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"141\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"142\">Ifaz Chowdhury</span> · Feb 05, 2026 · 6 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"143\">Gravity</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Mathematics\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"144\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--red);\" data-kid=\"145\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(220,38,38,0.12); color:#b91c1c;\" data-kid=\"146\">Mathematics</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"147\">The Golden Ratio Hidden in Nature</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"148\">An exploration of the Fibonacci sequence and how φ appears in sunflower spirals, pinecones and seashells around the schoolyard.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"149\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"150\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"151\">Maliha Noor</span> · Jan 22, 2026 · 4 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"152\">Patterns</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Environment\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"153\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:#0d9488;\" data-kid=\"154\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(13,148,136,0.13); color:#0f766e;\" data-kid=\"155\">Environment</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"156\">Measuring Our Campus Carbon Footprint</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"157\">A data-driven study estimating energy use across classrooms and proposing simple, low-cost steps toward a greener school.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"158\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"159\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"160\">Zahin Islam</span> · Jan 09, 2026 · 6 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"161\">Climate</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"Astronomy\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"162\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--blue);\" data-kid=\"163\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(96,165,250,0.16); color:#2563eb;\" data-kid=\"164\">Astronomy</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"165\">Phases of the Moon: A 30-Day Observation Log</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"166\">Tracking the lunar cycle through daily sketches, the team explored the geometry behind waxing, waning and the synodic month.</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"167\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"168\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"169\">Arian Mahmud</span> · Dec 18, 2026 · 5 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"170\">Moon</span>\n        </div>\n      </article>\n\n      \n      <article data-tags=\"test\" class=\"article-card group relative bg-white rounded-2xl p-6 flex flex-col shadow-subtle cursor-pointer transition-transform duration-300 hover:-translate-y-1 hover:shadow-academic\" style=\"border:1px solid rgba(0,95,107,0.1);\" data-kid=\"171\">\n        <span class=\"card-accent absolute top-0 left-0 h-1 w-full rounded-t-2xl\" style=\"background:var(--teal);\" data-kid=\"172\"></span>\n        <span class=\"self-start px-3 py-1 rounded-full text-xs font-display font-semibold mb-4\" style=\"background:rgba(0,95,107,0.09); color:var(--teal);\" data-kid=\"173\">test</span>\n        <h3 class=\"font-display font-bold text-lg leading-snug mb-2 line-clamp-2 transition-colors group-hover:text-[var(--teal)]\" style=\"color:var(--ink);\" data-kid=\"174\">dejavu</h3>\n        <p class=\"font-body text-sm line-clamp-3 mb-5\" style=\"color:rgba(20,35,38,0.6);\" data-kid=\"175\">it works</p>\n        <div class=\"mt-auto pt-4 flex items-center justify-between gap-2\" style=\"border-top:1px solid rgba(0,95,107,0.07);\" data-kid=\"176\">\n          <div class=\"text-xs\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"177\"><span class=\"font-medium\" style=\"color:rgba(20,35,38,0.8);\" data-kid=\"178\">abrar</span> · Jun 21, 2026 · 1 min</div>\n          <span class=\"px-2.5 py-1 rounded-full text-[11px] font-medium shrink-0\" style=\"background:rgba(0,95,107,0.1); color:var(--teal);\" data-kid=\"179\">test</span>\n        </div>\n      </article>\n\n    </div>\n\n    <p id=\"emptyState\" class=\"hidden text-center py-16 font-body\" style=\"color:rgba(20,35,38,0.5);\" data-kid=\"180\">No articles found for this topic.</p>\n  </main>\n\n  \n  <footer class=\"bg-white\" style=\"border-top:1px solid rgba(0,95,107,0.2);\" data-kid=\"181\">\n    <div class=\"max-w-7xl mx-auto px-6 py-14\" data-kid=\"182\">\n      <div class=\"grid md:grid-cols-3 gap-6 mb-8\" data-kid=\"183\">\n        \n        <div class=\"rounded-2xl p-7\" style=\"background:rgba(0,95,107,0.04);\" data-kid=\"184\">\n          <div class=\"font-display font-bold text-xs uppercase tracking-widest mb-5\" style=\"color:var(--teal);\" data-kid=\"185\">Contact</div>\n          <ul class=\"space-y-3.5 font-body text-sm\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"186\">\n            <li class=\"flex items-start gap-3\" data-kid=\"187\"><i data-lucide=\"map-pin\" style=\"width:17px;height:17px;color:var(--teal);\" class=\"mt-0.5 shrink-0\" data-kid=\"188\"></i>Manarat Dhaka Int'l School &amp; College, Gulshan, Dhaka</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"189\"><i data-lucide=\"mail\" style=\"width:17px;height:17px;color:var(--teal);\" class=\"shrink-0\" data-kid=\"190\"></i>scienceclub@manarat.edu.bd</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"191\"><i data-lucide=\"phone\" style=\"width:17px;height:17px;color:var(--teal);\" class=\"shrink-0\" data-kid=\"192\"></i>+880 1700-000000</li>\n          </ul>\n        </div>\n        \n        <div class=\"rounded-2xl p-7\" style=\"background:rgba(124,58,237,0.04);\" data-kid=\"193\">\n          <div class=\"font-display font-bold text-xs uppercase tracking-widest mb-5\" style=\"color:var(--purple);\" data-kid=\"194\">Explore</div>\n          <ul class=\"grid grid-cols-2 gap-x-4 gap-y-2.5 font-body text-sm\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"195\">\n            <li data-kid=\"196\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"197\">Home</a></li>\n            <li data-kid=\"198\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"199\">Institutional Legacy</a></li>\n            <li data-kid=\"200\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"201\">Achievements &amp; Accolades</a></li>\n            <li data-kid=\"202\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"203\">Research Hub</a></li>\n            <li data-kid=\"204\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"205\">Events Calendar</a></li>\n            <li data-kid=\"206\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"207\">Teams &amp; Projects</a></li>\n            <li data-kid=\"208\"><a href=\"#\" class=\"hover:text-[var(--purple)] transition-colors\" data-kid=\"209\">Join MSC</a></li>\n          </ul>\n        </div>\n        \n        <div class=\"rounded-2xl p-7\" style=\"background:rgba(220,38,38,0.04);\" data-kid=\"210\">\n          <div class=\"font-display font-bold text-xs uppercase tracking-widest mb-5\" style=\"color:var(--red);\" data-kid=\"211\">Community</div>\n          <ul class=\"space-y-3 font-body text-sm\" style=\"color:rgba(20,35,38,0.7);\" data-kid=\"212\">\n            <li class=\"flex items-center gap-3\" data-kid=\"213\"><i data-lucide=\"instagram\" style=\"width:17px;height:17px;color:var(--red);\" class=\"shrink-0\" data-kid=\"214\"></i>@manarat.scienceclub</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"215\"><i data-lucide=\"message-circle\" style=\"width:17px;height:17px;color:var(--red);\" class=\"shrink-0\" data-kid=\"216\"></i>Discord Server</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"217\"><i data-lucide=\"facebook\" style=\"width:17px;height:17px;color:var(--red);\" class=\"shrink-0\" data-kid=\"218\"></i>Manarat Science Club</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"219\"><i data-lucide=\"users\" style=\"width:17px;height:17px;color:var(--red);\" class=\"shrink-0\" data-kid=\"220\"></i>Brothers Group</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"221\"><i data-lucide=\"users\" style=\"width:17px;height:17px;color:var(--red);\" class=\"shrink-0\" data-kid=\"222\"></i>Sisters Group</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"rounded-xl px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-2 text-center\" style=\"background:rgba(0,95,107,0.05);\" data-kid=\"223\">\n        <p class=\"font-body text-xs\" style=\"color:rgba(20,35,38,0.55);\" data-kid=\"224\">© 2026 Manarat Science Club — Manarat Dhaka International School &amp; College. All rights reserved.</p>\n        <p class=\"font-body text-xs\" style=\"color:rgba(20,35,38,0.45);\" data-kid=\"225\">Designed &amp; built by the MSC Web Team.</p>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"226\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"227\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"228\"></script>\n<script data-kid=\"229\">\n  lucide.createIcons();\n  gsap.registerPlugin(ScrollTrigger);\n\n  // active chip base styles\n  const styleEl = document.createElement('style');\n  styleEl.textContent = `\n    .filter-chip{ border:1.5px solid rgba(0,95,107,0.15); color:rgba(20,35,38,0.7); transition:transform .2s ease, background-color .2s ease, color .2s ease, box-shadow .2s ease; }\n    .filter-chip:hover{ transform:translateY(-2px); box-shadow:0 8px 18px rgba(0,95,107,0.10); }\n    .filter-chip.active{ background:#005f6b; color:#fff; border-color:#005f6b; }\n    .filter-chip.active .opacity-50,.filter-chip.active .opacity-60{ opacity:.75; }\n  `;\n  document.head.appendChild(styleEl);\n\n  // featured card can transition immediately\n  document.querySelectorAll('.article-card:not(#articleGrid .article-card)').forEach(c=>c.classList.add('anim-done'));\n\n  // entrance animation\n  gsap.from(\"#articleGrid .article-card\", {\n    scrollTrigger:{ trigger:\"#articleGrid\", start:\"top 85%\" },\n    y:24, opacity:0, duration:.6, stagger:.07, ease:\"power2.out\",\n    onComplete:()=>document.querySelectorAll('#articleGrid .article-card').forEach(c=>c.classList.add('anim-done'))\n  });\n\n  // filter logic\n  const chips = document.querySelectorAll('.filter-chip');\n  const cards = document.querySelectorAll('#articleGrid .article-card');\n  const empty = document.getElementById('emptyState');\n  chips.forEach(chip=>{\n    chip.addEventListener('click',()=>{\n      chips.forEach(c=>c.classList.remove('active'));\n      chip.classList.add('active');\n      const f = chip.dataset.filter;\n      let visible = 0;\n      cards.forEach(card=>{\n        const tags = (card.dataset.tags||'');\n        const show = f==='all' || tags.includes(f);\n        card.classList.toggle('hidden', !show);\n        if(show) visible++;\n      });\n      empty.classList.toggle('hidden', visible>0);\n    });\n  });\n</script>",

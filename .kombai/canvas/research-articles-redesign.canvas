data-lucide=\"mail\" style=\"width:18px;height:18px;\" data-kid=\"189\"></i> Contact</h4>\n          <ul class=\"space-y-3 text-sm\" style=\"color: rgba(20,35,38,.7);\" data-kid=\"190\">\n            <li class=\"flex items-center gap-2.5\" data-kid=\"191\"><i data-lucide=\"map-pin\" style=\"width:16px;height:16px;color:var(--teal);\" data-kid=\"192\"></i> Manarat Dhaka Int'l School &amp; College</li>\n            <li class=\"flex items-center gap-2.5\" data-kid=\"193\"><i data-lucide=\"mail\" style=\"width:16px;height:16px;color:var(--teal);\" data-kid=\"194\"></i> science@manaratclub.edu</li>\n            <li class=\"flex items-center gap-2.5\" data-kid=\"195\"><i data-lucide=\"phone\" style=\"width:16px;height:16px;color:var(--teal);\" data-kid=\"196\"></i> +880 1700 000000</li>\n          </ul>\n        </div>\n        \n        <div class=\"rounded-2xl p-7\" style=\"background: rgba(124,58,237,.06);\" data-kid=\"197\">\n          <h4 class=\"font-display font-bold text-lg mb-4 flex items-center gap-2\" style=\"color: var(--purple);\" data-kid=\"198\"><i data-lucide=\"compass\" style=\"width:18px;height:18px;\" data-kid=\"199\"></i> Explore</h4>\n          <ul class=\"grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm\" style=\"color: rgba(20,35,38,.7);\" data-kid=\"200\">\n            <li data-kid=\"201\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"202\">Home</a></li>\n            <li data-kid=\"203\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"204\">Institutional Legacy</a></li>\n            <li data-kid=\"205\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"206\">Achievements &amp; Accolades</a></li>\n            <li data-kid=\"207\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"208\">Research Hub</a></li>\n            <li data-kid=\"209\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"210\">Events Calendar</a></li>\n            <li data-kid=\"211\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"212\">Teams &amp; Projects</a></li>\n            <li data-kid=\"213\"><a href=\"#\" class=\"footlink inline-block\" data-kid=\"214\">Join MSC</a></li>\n          </ul>\n        </div>\n        \n        <div class=\"rounded-2xl p-7\" style=\"background: rgba(220,38,38,.06);\" data-kid=\"215\">\n          <h4 class=\"font-display font-bold text-lg mb-4 flex items-center gap-2\" style=\"color: var(--red);\" data-kid=\"216\"><i data-lucide=\"users\" style=\"width:18px;height:18px;\" data-kid=\"217\"></i> Community</h4>\n          <div class=\"flex gap-2.5 mb-4\" data-kid=\"218\">\n            <a href=\"#\" class=\"w-9 h-9 rounded-xl bg-white shadow-soft flex items-center justify-center\" data-kid=\"219\"><i data-lucide=\"instagram\" style=\"width:18px;height:18px;color:var(--pink);\" data-kid=\"220\"></i></a>\n            <a href=\"#\" class=\"w-9 h-9 rounded-xl bg-white shadow-soft flex items-center justify-center\" data-kid=\"221\"><i data-lucide=\"message-circle\" style=\"width:18px;height:18px;color:var(--purple);\" data-kid=\"222\"></i></a>\n            <a href=\"#\" class=\"w-9 h-9 rounded-xl bg-white shadow-soft flex items-center justify-center\" data-kid=\"223\"><i data-lucide=\"facebook\" style=\"width:18px;height:18px;color:var(--blue);\" data-kid=\"224\"></i></a>\n          </div>\n          <ul class=\"space-y-2.5 text-sm\" style=\"color: rgba(20,35,38,.7);\" data-kid=\"225\">\n            <li data-kid=\"226\"><a href=\"#\" class=\"footlink inline-flex items-center gap-2\" data-kid=\"227\"><i data-lucide=\"users\" style=\"width:16px;height:16px;color:var(--red);\" data-kid=\"228\"></i> Brothers Group</a></li>\n            <li data-kid=\"229\"><a href=\"#\" class=\"footlink inline-flex items-center gap-2\" data-kid=\"230\"><i data-lucide=\"users\" style=\"width:16px;height:16px;color:var(--red);\" data-kid=\"231\"></i> Sisters Group</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"mt-8 rounded-xl px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs\" style=\"background: rgba(0,95,107,.05); color: rgba(20,35,38,.55);\" data-kid=\"232\">\n        <span data-kid=\"233\">© 2026 Manarat Science Club — Manarat Dhaka International School &amp; College. All rights reserved.</span>\n        <span data-kid=\"234\">Designed &amp; built by the MSC Web Team.</span>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"235\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"236\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"237\"></script>\n<script data-kid=\"238\">\n  // ----- Article data -----\n  const colors = {\n    physics: {dot:'#60a5fa', text:'#2563eb', bg:'rgba(96,165,250,.15)'},\n    astronomy: {dot:'#7c3aed', text:'#7c3aed', bg:'rgba(124,58,237,.13)'},\n    biology: {dot:'#ec4899', text:'#db2777', bg:'rgba(236,72,153,.13)'},\n    chemistry: {dot:'#dc2626', text:'#dc2626', bg:'rgba(220,38,38,.1)'},\n    robotics: {dot:'#ffb703', text:'#b45309', bg:'rgba(255,183,3,.18)'},\n    mathematics: {dot:'#005f6b', text:'#005f6b', bg:'rgba(0,95,107,.1)'},\n    environment: {dot:'#16a34a', text:'#16a34a', bg:'rgba(22,163,74,.12)'}\n  };\n  const accent = {physics:'#60a5fa',astronomy:'#7c3aed',biology:'#ec4899',chemistry:'#dc2626',robotics:'#ffb703',mathematics:'#005f6b',environment:'#16a34a'};\n\n  const articles = [\n    {tag:'test', topic:'physics', title:'dejavu', excerpt:'it works', author:'abrar', date:'Jun 21, 2026', read:'1 min read', extra:'Test'},\n    {topic:'astronomy', title:'Mapping Sunspot Cycles with a Backyard Telescope', excerpt:'A semester-long observation log tracking sunspot activity and correlating it with the 11-year solar cycle using affordable equipment.', author:'Nusaiba Karim', date:'Jun 14, 2026', read:'8 min read', extra:'Solar'},\n    {topic:'biology', title:'CRISPR Explained for High Schoolers', excerpt:'Breaking down gene-editing technology into approachable concepts, with diagrams and a discussion of its ethical frontiers.', author:'Tahmid Hasan', date:'Jun 09, 2026', read:'5 min read', extra:'Genetics'},\n    {topic:'robotics', title:'Building a Line-Following Robot in a Weekend', excerpt:'A complete build log of our IR-sensor robot — from breadboard prototype to a chassis that completes the track in under 30 seconds.', author:'Rafi Ahmed', date:'Jun 02, 2026', read:'7 min read', extra:'Arduino'},\n    {topic:'chemistry', title:'The Chemistry of Color-Changing Reactions', excerpt:'Exploring redox indicators and the famous iodine clock reaction with safe, repeatable classroom demonstrations.', author:'Sadia Islam', date:'May 27, 2026', read:'4 min read', extra:'Reactions'},\n    {topic:'mathematics', title:'Why Prime Numbers Never Stop', excerpt:'A friendly walkthrough of Euclid\\'s proof of the infinitude of primes and why the result still amazes mathematicians today.', author:'Imran Chowdhury', date:'May 19, 2026', read:'6 min read', extra:'Proofs'},\n    {topic:'environment', title:'Measuring Air Quality Around Our Campus', excerpt:'Deploying low-cost particulate sensors across the school to map pollution hotspots and propose greener routes.', author:'Maliha Noor', date:'May 11, 2026', read:'9 min read', extra:'Ecology'},\n    {topic:'physics', title:'Standing Waves on a Vibrating String', excerpt:'Measuring harmonics and resonant frequencies with a function generator and a length of fishing line clamped in the lab.', author:'Zayan Kabir', date:'May 04, 2026', read:'5 min read', extra:'Waves'},\n    {topic:'astronomy', title:'Photographing the Phases of the Moon', excerpt:'A month of lunar imaging tips, exposure settings, and stacking techniques to bring out crater detail.', author:'Rumana Akter', date:'Apr 28, 2026', read:'6 min read', extra:'Imaging'}\n  ];\n\n  function cap(s){return s.charAt(0).toUpperCase()+s.slice(1);}\n\n  const grid = document.getElementById('articleGrid');\n  grid.innerHTML = articles.map(a => {\n    const c = colors[a.topic];\n    return `\n    <article class=\"article-card topcard relative rounded-2xl bg-white border shadow-soft hover:shadow-academic p-6 overflow-hidden\" data-tags=\"${a.topic}\" style=\"border-color: rgba(0,95,107,.1); --accent:${accent[a.topic]};\">\n      <div class=\"topbar-accent absolute top-0 left-0 right-0 h-1.5\" style=\"background:${accent[a.topic]};\"></div>\n      <span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-display font-semibold mb-3\" style=\"background:${c.bg}; color:${c.text};\"><span class=\"w-1.5 h-1.5 rounded-full\" style=\"background:${c.dot};\"></span>${cap(a.topic)}</span>\n      <h3 class=\"title-link font-display font-bold text-xl leading-snug line-clamp-2\" style=\"color: var(--ink);\">${a.title}</h3>\n      <p class=\"mt-2.5 text-sm leading-relaxed line-clamp-3\" style=\"color: rgba(20,35,38,.6);\">${a.excerpt}</p>\n      <div class=\"mt-5 pt-4 border-t flex items-center justify-between gap-3\" style=\"border-color: rgba(0,95,107,.08);\">\n        <div class=\"flex items-center gap-3 text-xs flex-wrap\" style=\"color: rgba(20,35,38,.45);\">\n          <span class=\"flex items-center gap-1\"><i data-lucide=\"user-round\" style=\"width:13px;height:13px;color:var(--teal);\"></i> ${a.author}</span>\n          <span>·</span>\n          <span>${a.date}</span>\n          <span>·</span>\n          <span>${a.read}</span>\n        </div>\n        <span class=\"shrink-0 px-2.5 py-1 rounded-full text-xs font-display font-medium\" style=\"background: rgba(0,95,107,.08); color:var(--teal);\">${a.extra}</span>\n      </div>\n    </article>`;\n  }).join('');\n\n  lucide.createIcons();\n\n  // ----- Filtering -----\n  const chips = document.querySelectorAll('.filter-chip');\n  const topicBtns = document.querySelectorAll('.topic-btn');\n  const cards = document.querySelectorAll('#articleGrid .article-card');\n  const featured = document.querySelector('.mb-10 .article-card');\n  const visCount = document.getElementById('visCount');\n\n  function setActiveChip(filter){\n    chips.forEach(ch => {\n      const active = ch.dataset.filter === filter;\n      ch.classList.toggle('active', active);\n      const dot = ch.querySelector('span:first-child');\n      if(ch.dataset.filter === 'all'){\n        if(active){ ch.style.background='var(--teal)'; ch.style.color='#fff'; }\n        else { ch.style.background='#fff'; ch.style.color='rgba(20,35,38,.7)'; }\n      } else {\n        if(active){ ch.style.background='var(--teal)'; ch.style.color='#fff'; ch.style.borderColor='var(--teal)'; }\n        else { ch.style.background='#fff'; ch.style.color='rgba(20,35,38,.7)'; ch.style.borderColor='rgba(0,95,107,.15)'; }\n      }\n    });\n  }\n\n  function applyFilter(filter){\n    setActiveChip(filter);\n    let visible = 0;\n    cards.forEach(card => {\n      const match = filter === 'all' || card.dataset.tags.includes(filter);\n      card.classList.toggle('dimmed', !match);\n      if(match) visible++;\n    });\n    // featured\n    const fMatch = filter === 'all' || (featured && featured.dataset.tags.includes(filter));\n    if(featured) featured.classList.toggle('dimmed', !fMatch);\n    visCount.textContent = visible;\n  }\n\n  chips.forEach(ch => ch.addEventListener('click', () => applyFilter(ch.dataset.filter)));\n  topicBtns.forEach(b => b.addEventListener('click', () => applyFilter(b.dataset.filter)));\n\n  // ----- Entrance animations -----\n  window.addEventListener('load', () => {\n    gsap.from('.hero-anim', {y:24, opacity:0, duration:.7, stagger:.1, ease:'power2.out'});\n    gsap.from('.hero-panel', {scale:.92, opacity:0, duration:.8, ease:'power2.out', delay:.2});\n    gsap.from('#filterBar .filter-chip', {y:14, opacity:0, duration:.4, stagger:.04, ease:'power2.out', scrollTrigger:{trigger:'#filterBar', start:'top 85%'}});\n    gsap.from('#articleGrid .article-card', {y:30, opacity:0, duration:.5, stagger:.08, ease:'power2.out', scrollTrigger:{trigger:'#articleGrid', start:'top 80%'}});\n  });\n</script>",
